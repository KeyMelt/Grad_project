# ============================================================
# RL Platform - DigitalOcean Production Environment
# ============================================================
# Copy this to .env in your deploy directory on the droplet.
# Never commit this file with real values.
#
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================

# --- Docker Images ---
RL_IDE_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/rl-platform-backend:latest
RL_IDE_FRONTEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/rl-platform-frontend:latest

# --- Required Secrets (must be set) ---
RL_IDE_INTERNAL_TOKEN=                    # Gateway/services auth token
RL_IDE_AUTH_TOKEN_SECRET=                 # User session signing key
RL_IDE_SHELL_TOKEN_SECRET=                # Workspace shell token

# --- Firebase ---
RL_IDE_FIREBASE_CREDENTIALS_FILE=/srv/rl-platform/secrets/firebase-admin-key.json
RL_IDE_FIREBASE_APP_NAME=rl-ide-backend
RL_IDE_BOOTSTRAP_ADMIN_FIREBASE_UID=      # UID from Firebase Console Authentication

# --- CORS (your domain, comma-separated) ---
RL_IDE_ALLOWED_ORIGINS=https://your-domain.com

# --- Production security flags ---
RL_IDE_OPEN_PROVISIONING=0
RL_IDE_ALLOW_LEGACY_PASSWORD_SIGN_IN=0

# --- Database (SQLite, persisted via volume) ---
RL_IDE_DB_URL=sqlite:////srv/rl-platform/data/rl_learning_platform.db

# --- Workspace execution ---
RL_IDE_WORKSPACE_USE_DOCKER=1
RL_IDE_WORKSPACE_IMAGE=python:3.11-slim
RL_IDE_WORKSPACE_BASE_DIR=/srv/rl-platform/data/workspaces
RL_IDE_JOB_STORE_PATH=/srv/rl-platform/data/execution_jobs.db
RL_IDE_WORKSPACE_STORE_PATH=/srv/rl-platform/data/workspace_state.db
RL_IDE_ARTIFACT_STORE_PATH=/srv/rl-platform/data/execution_artifacts.db

# --- Visualization ---
RL_IDE_VISUALIZATION_OUTPUT_DIR=/srv/rl-platform/animations
RL_IDE_CONCEPT_VIDEO_DIR=/srv/rl-platform/concept-videos
RL_IDE_MANIM_PYTHON=python3
RL_IDE_MANIM_SERVICE_URL=http://manim-service:8300
RL_IDE_MANIM_RENDER_QUALITY=l

# --- Gemini AI (optional) ---
RL_IDE_GEMINI_ENABLED=0
GEMINI_API_KEY=
RL_IDE_GEMINI_MODEL=gemini-3.1-flash

# --- Port bindings ---
RL_IDE_HTTP_BIND=0.0.0.0:80
RL_IDE_HTTPS_BIND=0.0.0.0:443
RL_IDE_GATEWAY_BIND=127.0.0.1:8000
RL_IDE_TLS_DOMAIN=your-domain.com
