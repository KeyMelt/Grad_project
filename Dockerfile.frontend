# Stage 1: Build Flutter web app
FROM ghcr.io/cirruslabs/flutter:stable AS builder

WORKDIR /build
ARG RL_IDE_ALLOW_LOCAL_LESSON_FALLBACK=false

# Copy frontend source
COPY frontend/ .

# Get dependencies
RUN flutter pub get

# Build Flutter web (BACKEND_BASE_URL left empty so runtime origin-fallback kicks in)
RUN flutter build web --release \
    --pwa-strategy=none \
    --dart-define=BACKEND_BASE_URL="" \
    --dart-define=RL_IDE_ALLOW_LOCAL_LESSON_FALLBACK=${RL_IDE_ALLOW_LOCAL_LESSON_FALLBACK}

# Keep a cleanup worker at the legacy Flutter service-worker URL so browsers
# with an older registered worker can clear stale Flutter caches.
RUN cp web/flutter_service_worker.js build/web/flutter_service_worker.js

# Stage 2: Serve with Nginx
FROM nginx:1.27-alpine

# Copy built web assets
COPY --from=builder /build/build/web /usr/share/nginx/html

# Copy Nginx configs. The startup hook selects TLS when certificates are mounted.
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY nginx/nginx.conf /etc/nginx/default-http.conf
COPY nginx/nginx-ssl.conf /etc/nginx/default-ssl.conf
COPY nginx/99-select-frontend-config.sh /docker-entrypoint.d/99-select-frontend-config.sh
RUN chmod +x /docker-entrypoint.d/99-select-frontend-config.sh

EXPOSE 80
EXPOSE 443
