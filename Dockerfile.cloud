FROM python:3.11-slim

ARG DOCKER_CLI_VERSION=27.5.1

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      pkg-config \
      libcairo2-dev \
      libpango1.0-dev \
      ffmpeg \
      curl \
      libsdl2-2.0-0 \
      libsdl2-ttf-2.0-0 \
      ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    arch="$(uname -m)"; \
    case "${arch}" in \
      x86_64) docker_arch="x86_64" ;; \
      aarch64|arm64) docker_arch="aarch64" ;; \
      *) echo "Unsupported Docker CLI architecture: ${arch}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://download.docker.com/linux/static/stable/${docker_arch}/docker-${DOCKER_CLI_VERSION}.tgz" -o /tmp/docker.tgz; \
    tar -xzf /tmp/docker.tgz -C /tmp; \
    install -m 0755 /tmp/docker/docker /usr/local/bin/docker; \
    rm -rf /tmp/docker /tmp/docker.tgz; \
    docker --version

RUN useradd --create-home --uid 10001 appuser

WORKDIR /app

COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip && pip install -r /tmp/requirements.txt

COPY backend /app/backend
COPY docker/entrypoint.cloud.sh /app/docker/entrypoint.cloud.sh

RUN mkdir -p /app/backend/data \
    /app/backend/visualization/animations \
    /app/backend/media/concept_videos && \
    chmod +x /app/docker/entrypoint.cloud.sh && \
    chown -R appuser:appuser /app

EXPOSE 8000
EXPOSE 8100
EXPOSE 8200

USER appuser

ENTRYPOINT ["/app/docker/entrypoint.cloud.sh"]
