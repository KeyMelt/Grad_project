# Backend service mode
RL_IDE_EXECUTION_MODE=remote
RL_IDE_USER_SERVICE_MODE=remote
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RL_IDE_INTERNAL_TOKEN=<generate-with-secrets.token_urlsafe(32)>

# Public gateway and internal services
RL_IDE_GATEWAY_PORT=8000
RL_IDE_EXECUTION_WORKER_PORT=8100
RL_IDE_USER_EVALUATION_PORT=8200
RL_IDE_EXECUTION_WORKER_URL=http://127.0.0.1:8100
RL_IDE_USER_SERVICE_URL=http://127.0.0.1:8200
RL_IDE_WORKER_TIMEOUT_SECONDS=10
RL_IDE_USER_SERVICE_TIMEOUT_SECONDS=10
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RL_IDE_AUTH_TOKEN_SECRET=<generate-with-secrets.token_urlsafe(32)>
RL_IDE_SHELL_TOKEN_SECRET=<generate-with-secrets.token_urlsafe(32)>

# Persistence
RL_IDE_DB_URL=sqlite:///backend/data/rl_learning_platform.db
RL_IDE_JOB_STORE_PATH=backend/data/execution_jobs.db
RL_IDE_ARTIFACT_STORE_PATH=backend/data/execution_artifacts.db
RL_IDE_WORKSPACE_STORE_PATH=backend/data/workspace_state.db

# Workspace runtime
RL_IDE_WORKSPACE_USE_DOCKER=1
RL_IDE_WORKSPACE_IMAGE=python:3.11-slim
RL_IDE_WORKSPACE_BASE_DIR=backend/data/workspaces

# Visualization and execution limits
RL_IDE_VISUALIZATION_OUTPUT_DIR=backend/visualization/animations
RL_IDE_CONCEPT_VIDEO_DIR=backend/media/concept_videos
RL_IDE_MANIM_PYTHON=python3
RL_IDE_MANIM_TIMEOUT_SECONDS=300
RL_IDE_EXECUTION_TIMEOUT_BASE_SECONDS=300
RL_IDE_EXECUTION_TIMEOUT_PER_EPISODE_SECONDS=5
RL_IDE_EXECUTION_TIMEOUT_MAX_SECONDS=900

# Optional DigitalOcean Spaces media publishing. Use `local` for development.
RL_IDE_MEDIA_STORAGE_BACKEND=local
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=grad-project-prod-media-fra1
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_CDN_URL=https://grad-project-prod-media-fra1.fra1.cdn.digitaloceanspaces.com
DO_SPACES_ACCESS_KEY=<digitalocean-spaces-access-key>
DO_SPACES_SECRET_KEY=<digitalocean-spaces-secret-key>

# Firebase is required — the backend verifies Firebase ID tokens from the
# Flutter client. Run `flutterfire configure` and drop the service-account
# JSON at backend/secrets/firebase-admin-key.json (gitignored).
RL_IDE_FIREBASE_CREDENTIALS_PATH=backend/secrets/firebase-admin-key.json
RL_IDE_FIREBASE_APP_NAME=rl-ide-backend
# Firebase UID of the first admin user — find in Firebase Console > Authentication
RL_IDE_BOOTSTRAP_ADMIN_FIREBASE_UID=<firebase-uid-of-admin-user>
RL_IDE_BOOTSTRAP_ADMIN_DISPLAY_NAME="Platform Admin"
# Set to 0 in production — requires explicit admin approval for new accounts
RL_IDE_OPEN_PROVISIONING=1
# Set to 0 in production — disables legacy password auth path
RL_IDE_ALLOW_LEGACY_PASSWORD_SIGN_IN=1
RL_IDE_GEMINI_ENABLED=0
# Obtain from Google AI Studio; never commit real key
GEMINI_API_KEY=<your-gemini-api-key>
RL_IDE_GEMINI_MODEL=gemini-2.5-flash
RL_IDE_GEMINI_TIMEOUT_SECONDS=5
