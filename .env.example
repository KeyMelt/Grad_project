# Backend service mode
RL_IDE_EXECUTION_MODE=remote
RL_IDE_USER_SERVICE_MODE=remote
RL_IDE_INTERNAL_TOKEN=change-this-local-dev-token

# Public gateway and internal services
RL_IDE_GATEWAY_PORT=8000
RL_IDE_EXECUTION_WORKER_PORT=8100
RL_IDE_USER_EVALUATION_PORT=8200
RL_IDE_EXECUTION_WORKER_URL=http://127.0.0.1:8100
RL_IDE_USER_SERVICE_URL=http://127.0.0.1:8200
RL_IDE_WORKER_TIMEOUT_SECONDS=10
RL_IDE_USER_SERVICE_TIMEOUT_SECONDS=10

# Persistence
RL_IDE_DB_URL=sqlite:///backend/data/rl_learning_platform.db
RL_IDE_JOB_STORE_PATH=backend/data/execution_jobs.db
RL_IDE_ARTIFACT_STORE_PATH=backend/data/execution_artifacts.db
RL_IDE_WORKSPACE_STORE_PATH=backend/data/workspace_state.db

# Workspace runtime
RL_IDE_WORKSPACE_USE_DOCKER=1
RL_IDE_WORKSPACE_IMAGE=python:3.11-slim
RL_IDE_WORKSPACE_BASE_DIR=backend/data/workspaces

# Visualization and execution limits
RL_IDE_VISUALIZATION_OUTPUT_DIR=backend/visualization/animations
RL_IDE_CONCEPT_VIDEO_DIR=backend/media/concept_videos
RL_IDE_MANIM_PYTHON=python3
RL_IDE_MANIM_TIMEOUT_SECONDS=300
RL_IDE_EXECUTION_TIMEOUT_BASE_SECONDS=300
RL_IDE_EXECUTION_TIMEOUT_PER_EPISODE_SECONDS=5
RL_IDE_EXECUTION_TIMEOUT_MAX_SECONDS=900

# Firebase and Gemini are optional in local development.
RL_IDE_PROGRESS_BACKEND=sql
RL_IDE_FIREBASE_CREDENTIALS_PATH=
RL_IDE_FIREBASE_APP_NAME=rl-ide-backend
RL_IDE_GEMINI_ENABLED=0
GEMINI_API_KEY=
RL_IDE_GEMINI_MODEL=gemini-2.5-flash
RL_IDE_GEMINI_TIMEOUT_SECONDS=5
